@@ -17,0 +18,13 @@ html[data-theme="light"]{color-scheme:light;--bg:#fafbf9;--sidebar:#f0f2ef;--pan
+
+/* Image route and model catalogue; safe local outputs, no remote HTML previews. */
+.image-options{border-top:1px solid var(--line);padding:10px 6px;margin:6px 0 8px;color:var(--muted);font-size:11px}
+.image-mode-note{margin-bottom:9px;color:var(--accent)}.image-parameters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:8px}
