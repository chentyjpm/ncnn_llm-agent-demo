+.generated-images{padding-left:29px;display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));margin:14px 0}
+.generated-image{margin:0;border:1px solid var(--line);border-radius:13px;overflow:hidden;background:var(--card)}
